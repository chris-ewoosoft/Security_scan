# ─── Database ────────────────────────────────────────────────────────────────
# NOTE: role "securityportal" does not exist on the shared postgres server and
# "aiassistant" lacks CREATEDB, so the app uses the existing "aiassistant" database.
DD_DATABASE_URL=postgresql://postgres:aiassistant@172.76.10.246:5432/securityportal
DD_DATABASE_NAME=securityportal
DD_DATABASE_USER=postgres
DD_DATABASE_PASSWORD=aiassistant
DD_DATABASE_HOST=172.76.10.246
DD_DATABASE_PORT=5432


# ─── Redis ───────────────────────────────────────────────────────────────────
REDIS_PASSWORD=StrongRedisPassword123!

# ─── RabbitMQ ────────────────────────────────────────────────────────────────
RABBITMQ_USER=spuser
RABBITMQ_PASSWORD=StrongRabbitMQPassword123!

# ─── MinIO ───────────────────────────────────────────────────────────────────
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=minioadmin
MINIO_API_PORT=9002
MINIO_CONSOLE_PORT=9003

# ─── Host port overrides (avoid clashes with other local stacks) ─────────────
REDIS_HOST_PORT=6380

# ─── JWT ─────────────────────────────────────────────────────────────────────
# Generate with: openssl rand -base64 64
JWT_SECRET_KEY=CHANGE_THIS_TO_A_SECURE_256_BIT_KEY_BEFORE_DEPLOYMENT

# ─── SMTP ─────────────────────────────────────────────────────────────────────
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USERNAME=your-email@gmail.com
SMTP_PASSWORD=your-app-password

# ─── OpenAI ──────────────────────────────────────────────────────────────────
OPENAI_API_KEY=sk-your-openai-api-key
OPENAI_MODEL=gpt-4o

# ─── Grafana ─────────────────────────────────────────────────────────────────
GRAFANA_USER=admin
GRAFANA_PASSWORD=admin

# ─── ASP.NET ─────────────────────────────────────────────────────────────────
ASPNETCORE_ENVIRONMENT=Production
