{
  "Serilog": {
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Microsoft": "Warning",
        "System": "Warning",
        "Microsoft.EntityFrameworkCore": "Warning"
      }
    }
  },
  "ConnectionStrings": {
    "DefaultConnection": "Host=postgres;Port=5432;Database=securityportal;Username=postgres;Password=postgres",
    "Redis": "redis:6379"
  },
  "Jwt": {
    "SecretKey": "CHANGE-THIS-TO-A-SECURE-256-BIT-SECRET-KEY-IN-PRODUCTION",
    "Issuer": "SecurityPortal",
    "Audience": "SecurityPortal",
    "AccessTokenExpiryMinutes": 15,
    "RefreshTokenExpiryDays": 7
  },
  "Minio": {
    "Endpoint": "minio:9000",
    "AccessKey": "minioadmin",
    "SecretKey": "minioadmin",
    "UseSSL": false
  },
  "RabbitMQ": {
    "Host": "rabbitmq",
    "VirtualHost": "/",
    "Username": "guest",
    "Password": "guest"
  },
  "Cors": {
    "AllowedOrigins": [ "http://localhost:3000", "http://localhost", "http://localhost:5000", "https://security-portal.yourdomain.com" ]
  },
  "ScanSecrets": {
    "Key": "SecurityPortal-Dev-ScanSecrets-ChangeMe-32b!"
  },
  "SshContainment": {
    "ApplyEnabled": false,
    "AllowPrivateNetworks": false,
    "AllowedDestinations": [],
    "RuleLifetimeMinutes": 30
  },
  "AllowedHosts": "*"
}
